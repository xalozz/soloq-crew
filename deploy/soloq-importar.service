[Unit]
Description=SoloQ Crew: copia a SQLite lo que publica la GitHub Action (solo mientras no haya actualizador propio)
ConditionPathExists=!/etc/soloq/riot-api-key
After=soloq-espejo.service

[Service]
Type=oneshot
User=soloq
Group=soloq
WorkingDirectory=/srv/soloq/app
Environment=SOLOQ_DATA=/srv/soloq/data
ExecStart=/srv/soloq/app/.venv/bin/python -m soloq.importer importar /srv/soloq/web/data --espejo
TimeoutStartSec=50
MemoryMax=300M
CPUQuota=50%
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/soloq/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
