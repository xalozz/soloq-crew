[Unit]
Description=SoloQ Crew: actualizador (API de Riot -> SQLite), pasada rapida cada minuto y completa cada 15
After=network-online.target
Wants=network-online.target
# Solo tras el corte final (deploy/corte.sh deja la marca) y con clave de Riot. Antes, soloq-importar.timer copia
# lo que publica la GitHub Action; así, aunque la clave ya esté puesta, un reinicio no lo arranca antes de tiempo.
ConditionPathExists=/etc/soloq/corte
ConditionPathExists=/etc/soloq/riot-api-key

[Service]
User=soloq
Group=soloq
WorkingDirectory=/srv/soloq/app
Environment=SOLOQ_DATA=/srv/soloq/data
Environment=SOLOQ_SITE=https://soloq-nuevo.xalozz.es/
Environment=PYTHONUNBUFFERED=1
# Mientras conviva con la GitHub Action (misma clave): peticiones más espaciadas para no pasar entre las dos
# del límite de 100 cada 2 min. Tras el corte, quitar esta línea (vuelve a 1250 ms, como en Node).
Environment=MIN_INTERVAL_MS=2500
Environment=BACKFILL_BUDGET=120
LoadCredential=riot-api-key:/etc/soloq/riot-api-key
# Discord: solo tras el corte (si no, los avisos saldrían dos veces)
#LoadCredential=discord-webhook:/etc/soloq/discord-webhook
ExecStart=/srv/soloq/app/.venv/bin/python -m soloq.bucle
Restart=always
RestartSec=30

MemoryMax=400M
CPUQuota=50%
TasksMax=32

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/soloq/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
